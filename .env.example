# ==============================================================================
# REALPREMISE - VARIÁVEIS DE AMBIENTE (EXEMPLO PARA DEPLOY NO EASYPANEL)
# ==============================================================================

# Porta da aplicação (No Easypanel, aponte a porta do contêiner para 3000)
PORT=3000

# Ambiente de execução (production para build otimizado em produção)
NODE_ENV=production

# Chave secreta para criptografia e validação de tokens JWT de administradores
# Gere uma string aleatória forte (ex: openssl rand -base64 32)
JWT_SECRET=realpremise-super-secret-jwt-key-2026-production-secure

# Chave de API do Google Gemini (necessária para geração de notícias e redação autônoma)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...sua_chave_aqui

# URL base da aplicação hospedada (opcional, para links canônicos e SEO)
# Exemplo: https://sua-empresa.easypanel.host ou https://meusite.com.br
APP_URL=https://realpremise.exemplo.com
